# Copy to .env.local and adjust.
#
# Leave VITE_API_URL empty to use the dev server's proxy, which forwards /api,
# /t and /u to the backend below. That keeps the browser on a single origin in
# development, so CORS behaves the way it does in production.
#
# Set it to an absolute URL only when serving the built frontend from a
# different host than the API.
VITE_API_URL=

# Where the dev proxy forwards to.
#   local backend:  http://localhost:8000
#   deployed:       https://stylesense-api-vmwr.onrender.com
DEV_API_TARGET=http://localhost:8000
