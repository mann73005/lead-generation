# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# Supabase: Dashboard -> Connect -> Session pooler -> URI (port 5432, NOT 6543)
# Local:    postgresql+psycopg://postgres:postgres@localhost:5432/stylesense
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres?sslmode=require

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seeded on first startup so the console has a user to log in with.
BOOTSTRAP_USER_EMAIL=demo@stylesense.ai
BOOTSTRAP_USER_PASSWORD=demo1234

# --- LLM ------------------------------------------------------------------
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-3-flash-preview

# --- Search / fetch tools -------------------------------------------------
TAVILY_API_KEY=

# --- Email ----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM_NAME=Dhruv Gupta
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Every outbound send is redirected here regardless of the lead's stored
# address. Discovered prospects are never emailed (see README > Compliance).
EMAIL_OVERRIDE_TO=you@example.com

# --- Tracking -------------------------------------------------------------
# Must be publicly reachable for the open pixel to fire from a mail client.
# Local dev: ngrok http 8000  ->  https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:8000

# --- App ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
